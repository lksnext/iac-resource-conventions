{
  "name": "@lksnext/iac-conventions-cli",
  "version": "0.1.0",
  "description": "Command-line adapter for the iac-resource-conventions Reference Evaluator.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "iac-conventions": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@lksnext/iac-conventions-catalog": "^0.1.0",
    "@lksnext/iac-conventions-core": "^0.1.0"
  },
  "scripts": {
    "build": "npm run build -w @lksnext/iac-conventions-catalog && tsc -p tsconfig.json",
    "typecheck": "npm run build -w @lksnext/iac-conventions-catalog && tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/runtime/cli.test.mjs"
  }
