{
  "name": "@lksnext/iac-conventions-cli",
  "version": "0.1.0-alpha.0",
  "description": "Command-line adapter for the iac-resource-conventions Reference Evaluator.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lksnext/iac-resource-conventions.git",
    "directory": "packages/cli"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "bin": {
    "iac-conventions": "./dist/cli.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "dependencies": {
    "@lksnext/iac-conventions-catalog": "0.1.0-alpha.0",
    "@lksnext/iac-conventions-core": "0.1.0-alpha.0"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepack": "npm run build && node ../../scripts/copy-license-notice.mjs .",
    "build": "npm run build -w @lksnext/iac-conventions-catalog && tsc -p tsconfig.json",
    "typecheck": "npm run build -w @lksnext/iac-conventions-catalog && tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --experimental-test-module-mocks --test"
  }
}
